{
  "name": "healthcall",
  "private": true,
  "version": "4.0.0",
  "description": "Plataforma local-first para operação de UBS e ambulatórios, com fluxo e chamada de pacientes, agenda, comunicação interna, pendências, prescrições, avisos e acompanhamento de feridas.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "vite build",
    "healthcall": "npm run build && node server/healthcall-server.mjs",
    "healthcall:server": "node server/healthcall-server.mjs",
    "generate:pdf-icons": "node scripts/generate-pdf-icons.mjs",
    "preview": "vite preview",
    "test": "vitest run && npm run test:local",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:local": "node --test server/__tests__/healthcall-server.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-pdf/renderer": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exifreader": "^4.38.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "1.8.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/chromecast-caf-sender": "^1.0.11",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.24",
    "jsdom": "^25.0.1",
    "lucide-static": "1.8.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^2.1.8"
  }
}
