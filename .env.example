# HealthCall is local-first and works without any cloud account.
VITE_DATA_MODE=local

# Optional: only for legacy/cloud installations.
# VITE_DATA_MODE=supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-publishable-or-legacy-anon-key

# Optional local development override (Vite proxies /api to this server).
# VITE_LOCAL_DEV_SERVER=http://127.0.0.1:8787
